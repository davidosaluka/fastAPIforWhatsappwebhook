  "screens": [
    {
      "id": "CONFIRM_ADDRESS_SCREEN",
      "title": "Your Address",
      "data": {
        "address_display": {
          "type": "string",
          "__example__": "📍 Saved Address: 34 Oworo Street beside Shukura Hospital\n📞 Receiver's Phone: 081234567890"
        },
        "saved_address": {
          "type": "string",
          "__example__": "34 Oworo Street beside Shukura Hospital"
        },
        "saved_phone": {
          "type": "string",
          "__example__": "081234567890"
        },
        "use_previous": {
          "type": "string",
          "__example__": "yes"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "flow_path",
            "children": [
              {
                "type": "TextHeading",
                "text": "Delivery Details 🛵"
              },
              {
                "type": "TextBody",
                "text": "${data.address_display}"
              },
              {
                "type": "RadioButtonsGroup",
                "name": "use_previous",
                "label": "Use these details?",
                "required": true,
                "data-source": [
                  {
                    "id": "yes",
                    "title": "Yes, use this address"
                  },
                  {
                    "id": "no",
                    "title": "No, enter new address"
                  }
                ]
              },
              {
                "type": "Footer",
                "label": "Continue",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "use_previous": "${form.use_previous}",
                    "saved_address": "${data.saved_address}",
                    "saved_phone": "${data.saved_phone}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "RECOMMEND",
      "title": "Your Address",
      "data": {
        "screen_0_HouseFlat_Number_0": {
          "type": "string",
          "__example__": "34"
        },
        "screen_0_Street_Name_1": {
          "type": "string",
          "__example__": "Oworo Street beside Shukura Hosiptal"
        },
        "screen_0_Receivers_Number_2": {
          "type": "string",
          "__example__": "081234567890"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
