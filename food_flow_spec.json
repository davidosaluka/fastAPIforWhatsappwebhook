      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "flow_path",
            "children": [
              {
                "type": "Image",
                "src": "${data.restaurant_logo}"
              },
              {
                "type": "TextHeading",
                "text": "Chef's Special Packs 🍱"
              },
              {
                "type": "TextBody",
                "text": "Select a popular combo below, or choose 'Skip to Custom Pack' to customize your own meal:"
              },
              {
                "type": "RadioButtonsGroup",
                "name": "selected_pack",
                "label": "Select a Meal Pack",
                "required": true,
                "data-source": [
                  {
                    "id": "pack_classic_jollof",
                    "title": "Madam G Classic Jollof (₦5,300)",
                    "description": "Jollof Rice + Medium Chicken + Fried Plantain"
                  },
                  {
                    "id": "pack_swallow_combo",
                    "title": "Madam G Swallow Special (₦1,400)",
                    "description": "Semo + Egusi Soup + Goat Meat"
                  },
                  {
                    "id": "pack_fried_feast",
                    "title": "Madam G Fried Feast (₦3,300)",
                    "description": "Fried Rice + Big Beef (2 pcs) + Salad + Coke"
                  },
                  {
                    "id": "pack_rice_beans",
                    "title": "White Rice & Beans Special (₦2,300)",
                    "description": "White Rice and Beans + Big Beef (1 pc) + Plantain"
                  },
                  {
                    "id": "skip_to_custom",
                    "title": "🛠️ Skip to Custom Pack Builder",
                    "description": "Build your own meal: Rice/Swallow + Soup + Protein + Extras"
                  }
                ]
              },
              {
                "type": "Dropdown",
                "name": "pack_quantity",
                "label": "Pack Quantity",
                "required": true,
                "data-source": [
                  { "id": "1", "title": "1 Pack" },
                  { "id": "2", "title": "2 Packs" },
                  { "id": "3", "title": "3 Packs" },
                  { "id": "4", "title": "4 Packs" },
                  { "id": "5", "title": "5 Packs" }
                ]
              },
              {
                "type": "TextInput",
                "name": "pack_note",
                "label": "Pack instructions / notes (optional)",
                "required": false,
                "input-type": "text"
              },
              {
                "type": "Footer",
                "label": "Continue",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "selected_pack": "${form.selected_pack}",
                    "pack_quantity": "${form.pack_quantity}",
                    "pack_note": "${form.pack_note}",
                    "restaurant": "${data.restaurant}",
                    "delivery_address": "${data.delivery_address}",
                    "contact_phone": "${data.contact_phone}",
                    "cart_packs": "${data.cart_packs}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
