{
  "version": "7.3",
  "data_api_version": "3.0",
  "routing_model": {
    "CONFIRM_ADDRESS_SCREEN": ["RATE", "RECOMMEND"],
    "RECOMMEND": ["RATE"],
    "RATE": ["PREDESIGNED_PACKS_SCREEN"],
    "PREDESIGNED_PACKS_SCREEN": ["BUILD_CUSTOM_PACK_SCREEN", "CART_REVIEW_SCREEN"],
    "BUILD_CUSTOM_PACK_SCREEN": ["CART_REVIEW_SCREEN"],
    "CART_REVIEW_SCREEN": ["screen_itnvpz"],
    "screen_itnvpz": []
  },
  "screens": [
    {
      "id": "CONFIRM_ADDRESS_SCREEN",
      "title": "Your Address",
      "data": {
        "address_display": {
          "type": "string",
          "__example__": "📍 Saved Address: 34 Oworo Street beside Shukura Hospital\n📞 Receiver's Number: 081234567890"
        },
        "saved_address": {
          "type": "string",
          "__example__": "34 Oworo Street beside Shukura Hospital"
        },
        "saved_phone": {
          "type": "string",
          "__example__": "081234567890"
        },
        "use_previous": {
          "type": "string",
          "__example__": "yes"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "flow_path",
            "children": [
              {
                "type": "TextHeading",
                "text": "Delivery Details 🛵"
              },
              {
                "type": "TextBody",
                "text": "${data.address_display}"
              },
              {
                "type": "RadioButtonsGroup",
                "name": "use_previous",
                "label": "Deliver to this address?",
                "required": true,
                "data-source": [
                  {
                    "id": "yes",
                    "title": "Yes, use this address & contact"
                  },
                  {
                    "id": "no",
                    "title": "No, enter a new delivery address"
                  }
                ]
              },
              {
                "type": "Footer",
                "label": "Continue",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "use_previous": "${form.use_previous}",
                    "saved_address": "${data.saved_address}",
                    "saved_phone": "${data.saved_phone}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "RECOMMEND",
      "title": "Your Address",
      "data": {
        "screen_0_HouseFlat_Number_0": {
          "type": "string",
          "__example__": "34"
        },
        "screen_0_Street_Name_1": {
          "type": "string",
          "__example__": "Oworo Street beside Shukura Hosiptal"
        },
        "screen_0_Receivers_Number_2": {
          "type": "string",
          "__example__": "081234567890"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "flow_path",
            "children": [
              {
                "type": "TextInput",
                "name": "HouseFlat_Number_801bd0",
                "label": "House/Flat Number",
                "required": false,
                "input-type": "text",
                "helper-text": "34/Flat 4"
              },
              {
                "type": "TextArea",
                "name": "Street_Name_17f2ce",
                "label": "Street Name",
                "required": true,
                "helper-text": "Oworo Street beside Shukura Hosiptal"
              },
              {
                "type": "TextInput",
                "name": "Receivers_Number_eb5784",
                "label": "Receiver's Number",
                "required": true,
                "input-type": "phone",
                "helper-text": "081234567890"
              },
              {
                "type": "Footer",
                "label": "Continue",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "HouseFlat_Number_801bd0": "${form.HouseFlat_Number_801bd0}",
                    "Street_Name_17f2ce": "${form.Street_Name_17f2ce}",
                    "Receivers_Number_eb5784": "${form.Receivers_Number_eb5784}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "RATE",
      "title": "Pick a Restaurant",
      "data": {
        "delivery_address": {
          "type": "string",
          "__example__": "34 Oworo Street beside Shukura Hospital"
        },
        "contact_phone": {
          "type": "string",
          "__example__": "081234567890"
        },
        "screen_0_HouseFlat_Number_0": {
          "type": "string",
          "__example__": "34"
        },
        "screen_0_Street_Name_1": {
          "type": "string",
          "__example__": "Oworo Street beside Shukura Hosiptal"
        },
        "screen_0_Receivers_Number_2": {
          "type": "string",
          "__example__": "081234567890"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "flow_path",
            "children": [
              {
                "type": "CheckboxGroup",
                "name": "Restaurants_e39410",
                "label": "Restaurants",
                "required": true,
                "data-source": [
                  {
                    "id": "0_Madam_G_Restaurant",
                    "title": "Madam G Restaurant"
                  }
                ]
              },
              {
                "type": "Footer",
                "label": "Next",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "Restaurants_e39410": "${form.Restaurants_e39410}",
                    "delivery_address": "${data.delivery_address}",
                    "contact_phone": "${data.contact_phone}",
                    "screen_0_HouseFlat_Number_0": "${data.screen_0_HouseFlat_Number_0}",
                    "screen_0_Street_Name_1": "${data.screen_0_Street_Name_1}",
                    "screen_0_Receivers_Number_2": "${data.screen_0_Receivers_Number_2}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "PREDESIGNED_PACKS_SCREEN",
      "title": "Madam G Restaurant",
      "data": {
        "delivery_address": {
          "type": "string",
          "__example__": "34 Oworo Street"
        },
        "contact_phone": {
          "type": "string",
          "__example__": "081234567890"
        },
        "restaurant": {
          "type": "string",
          "__example__": "Madam G Restaurant"
        },
        "restaurant_logo": {
          "type": "string",
