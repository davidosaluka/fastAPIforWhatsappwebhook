                    "id": "pack_swallow_special",
                    "title": "Swallow Special (₦1,400)"
                  },
                  {
                    "id": "pack_fried_feast",
                    "title": "Fried Feast (₦3,300)"
                  },
                  {
                    "id": "pack_rice_beans",
                    "title": "Rice & Beans Combo (₦2,300)"
                  }
                ]
              },
              {
                "type": "TextInput",
                "name": "pack_quantity",
                "label": "Pack Multiplier",
                "required": false,
                "input-type": "number",
                "helper-text": "Copies of combo pack (default 1)"
              },
              {
                "type": "TextInput",
                "name": "pack_note",
                "label": "Pack Note",
                "required": false,
                "input-type": "text",
                "helper-text": "e.g. extra spicy / no pepper"
