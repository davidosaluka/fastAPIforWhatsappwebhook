          {
            "type": "Form",
            "name": "flow_path",
            "children": [
              {
                "type": "Image",
                "src": "${data.restaurant_logo}",
                "scale-type": "contain",
                "aspect-ratio": 1.0
              },
              {
                "type": "TextHeading",
                "text": "Choose Order Type 🍱"
              },
              {
                "type": "RadioButtonsGroup",
                "name": "selected_pack",
                "label": "Select Option",
                "required": true,
                "data-source": [
                  {
                    "id": "bulk_office_order",
                    "title": "📋 Bulk Office Order"
                  },
                  {
                    "id": "skip_to_custom",
